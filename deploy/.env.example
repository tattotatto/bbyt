# ============================================================
# HX Mall 生产环境变量模板
# 用法：复制为 deploy/.env.production 并填真实值，然后执行 deploy-prod.sh
#   cp deploy/.env.example deploy/.env.production
# 注意：本文件含密钥占位，绝不提交 git；.env.production 不要入库
# ============================================================

# ---- 应用 ----
DEBUG=false

# ---- 数据库 / Redis（部署脚本会用 docker-compose 注入覆盖，此处在无 compose 时兜底）----
# DATABASE_URL=postgresql+asyncpg://postgres:<强密码>@db:5432/hxmall
# REDIS_URL=redis://redis:6379/0

# ---- 安全：JWT 密钥（务必用强随机串）----
# 生成：openssl rand -hex 32
JWT_SECRET_KEY=

# ---- 微信小程序（正式）----
# 留空 = 开发模式（wx-login 不调微信，code 以 dev_ 开头签发测试 token）
WECHAT_APPID=
WECHAT_SECRET=

# ---- AI 助手（可选；不配则 AI 对话不可用）----
# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
AI_DEFAULT_MODEL=deepseek
# 千问
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-max

# ---- 向量检索（知识库，可选）----
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
