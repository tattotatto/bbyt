<!-- wx:if 按当前路由决定整条底栏渲不渲染：客服页要沉浸式聊天（spec §2 #12），
     而底栏是微信挂在每个 tabBar 页上的这个组件，页面侧拦不住。 -->
<view class="tabbar" wx:if="{{!hidden}}">
  <view class="tabbar__bar">
    <view
      wx:for="{{tabs}}"
      wx:key="pagePath"
      class="tabbar__item {{item.raised ? 'tabbar__item--placeholder' : ''}}"
      data-index="{{index}}"
      bindtap="switchTo"
    >
      <block wx:if="{{!item.raised}}">
        <!-- 原生 <text> 而不是 <u-icon>：后者是编译过的 uni-app 组件，
             它的 props 只走 u-p 通道，原生 wxml 传不进去 —— 传进去的
             name 是 undefined，图标渲染成空串，且没有任何报错。
             完整推演见 index.js 顶部「为什么底栏不能直接用 <u-icon>」。
             字形码点来自 index.js 的 GLYPHS，颜色/字号在 index.wxss。 -->
        <text
          class="tabbar__icon {{selected === index ? 'tabbar__icon--active' : ''}}"
        >{{selected === index ? item.glyphActive : item.glyph}}</text>
        <text class="tabbar__label {{selected === index ? 'tabbar__label--active' : ''}}">{{item.text}}</text>
      </block>
    </view>
  </view>

  <!-- 凸起圆：绝对定位压在白底栏上，无描边 -->
  <view class="tabbar__raised" data-index="{{raisedIndex}}" bindtap="switchTo">
    <text class="tabbar__icon tabbar__icon--raised">{{tabs[raisedIndex].glyphActive}}</text>
  </view>
</view>
